OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
WHATSAPP_GROUP_ID=
# Set true to send immediately when starting (only after group ID configured)
SEND_ON_START=false

# Optional production override and separate playground destination
